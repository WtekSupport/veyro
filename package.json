{
  "name": "veyro",
  "private": true,
  "version": "1.10.34",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/ensure-git-hooks.mjs",
    "predev": "node scripts/free-dev-port.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "powershell -ExecutionPolicy Bypass -File scripts/tauri-dev-local.ps1",
    "sync-version": "node scripts/sync-version.mjs",
    "tauri:build": "powershell -ExecutionPolicy Bypass -File scripts/tauri-build-local.ps1",
    "tauri:dev:local": "powershell -ExecutionPolicy Bypass -File scripts/tauri-dev-local.ps1",
    "tauri:dev:direct": "powershell -ExecutionPolicy Bypass -File scripts/tauri-dev-direct.ps1",
    "tauri:build:local": "powershell -ExecutionPolicy Bypass -File scripts/tauri-build-local.ps1",
    "tauri:build:release": "powershell -ExecutionPolicy Bypass -File scripts/tauri-build-local.ps1 -SkipVersionBump",
    "tauri:build:dist": "powershell -ExecutionPolicy Bypass -File scripts/tauri-build-local.ps1 -PublishProfile",
    "tauri:dev:mac": "node scripts/tauri-macos.mjs dev",
    "tauri:build:mac": "node scripts/tauri-macos.mjs build",
    "start:release": "powershell -ExecutionPolicy Bypass -File scripts/launch-release.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "lucide": "^1.48.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.3"
  }
}
