# Optional local overrides (copy to .env — never commit .env).
# Veyro does not require a .env file for normal dev or release builds.

# Example: point Cargo to a custom target dir (also see scripts/ensure-cargo-target.ps1)
# CARGO_TARGET_DIR=C:\veyro-target

# Example: disable local GPU features for faster CI-like builds (see docs/BUILD.en.md)
# VEYRO_LOCAL_FEATURES=cloud-only
